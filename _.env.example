# Copy this file to .env for local development (never commit .env)

# Postgres connection string from Neon or Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional (Render sets this automatically)
PORT=3000
